# Copie para .env: cp .env.example .env

# Banco (Postgres + pgvector via docker compose)
# Usuário com permissão de escrita: usado só pela ingestão
DATABASE_URL=postgresql://camara:camara@localhost:5432/camara
# Usuário somente leitura: usado pelo agente para executar o SQL gerado
DATABASE_URL_LEITURA=postgresql://agente_leitura:leitura@localhost:5432/camara

# Fontes de dados
CAMARA_API_URL=https://dadosabertos.camara.leg.br/api/v2
CAMARA_COTAS_URL=https://www.camara.leg.br/cotas/Ano-{ano}.csv.zip
ANOS=2024,2025

# Embeddings (local, sem custo)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# LLM: "ollama" (local, padrão) ou "openai"
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# Para text-to-SQL e tool calling, prefira 7B ou mais
OLLAMA_MODEL=qwen2.5:7b
# Janela de contexto: o padrão do Ollama é pequeno para schema + categorias + resultados
OLLAMA_NUM_CTX=8192
# Em CPU (sem GPU) a primeira resposta pode passar de 2 minutos
OLLAMA_TIMEOUT_S=300
# Mantém o modelo na memória entre perguntas (evita recarregar a cada uso)
OLLAMA_KEEP_ALIVE=30m
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Segurança do agente
SQL_LIMITE_LINHAS=200
SQL_TIMEOUT_MS=5000
AGENTE_MAX_PASSOS=6
# Falhas seguidas de SQL que o agente pode corrigir antes de desistir
AGENTE_MAX_CORRECOES=2
# Máximo de linhas do resultado devolvidas ao modelo (a resposta traz todas)
AGENTE_LINHAS_PARA_LLM=50
AGENTE_LOG_PATH=logs/agente.jsonl

# Gráficos: acima disso, comparações viram tabela
GRAFICO_MAX_BARRAS=20

# Demo: endereço da API (127.0.0.1 evita a espera do IPv6 no Windows)
API_URL=http://127.0.0.1:8000
# Tempo máximo entre dois eventos da API; um passo em CPU pode levar minutos
DEMO_TIMEOUT_S=900
